        "y0": 81.69135000000009,
        "x1": 240.79074000000003,
        "y1": 91.69135000000009
      },
      "type": "furniture",
      "state": "typed",
      "text": "测试书 · 流水线样章",
      "bold": false,
      "findings": [],
